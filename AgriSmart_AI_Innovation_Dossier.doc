  <tr>
    <td><strong>Farmer Interface</strong></td>
    <td>Unidirectional Text</td>
    <td>Visual App (Requires Literacy)</td>
    <td>Complex Desktop/Tablet UI</td>
    <td><strong>Multimodal Conversational Vernacular Voice & WhatsApp</strong></td>
  </tr>
  <tr>
    <td><strong>Remedy Neutrality</strong></td>
    <td>Government recommendations</td>
    <td>Affiliated pesticide sales bias</td>
    <td>Corporate agronomic bias</td>
    <td><strong>Objective Algorithm: Bio-Organic First, Chemical Last-Resort</strong></td>
  </tr>
</table>

